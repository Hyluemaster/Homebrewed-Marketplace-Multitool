<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Homebrewed_Marketplace_Multitool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Homebrewed_Marketplace_Multitool.Views.LibraryWindow"
        x:DataType="vm:LibraryViewModel"
        Title="Library"
        Width="1100" Height="700" MinWidth="760" MinHeight="480">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="My Library" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Choose a book from the shelf to read its contents."
                           Foreground="#AAB4C3" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Add file"
                    Click="OnAddBookClick"
                    VerticalAlignment="Center"
                    Padding="16,9" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,6,*" ColumnSpacing="10">
            <Border Grid.Column="0" Padding="12" CornerRadius="10" Background="#252B35">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="SHELF" FontSize="12" FontWeight="Bold"
                               LetterSpacing="1.5" Foreground="#AAB4C3" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookShelfItemViewModel">
                                <Border Width="104" Height="190" Margin="5"
                                        Padding="10" CornerRadius="5"
                                        Background="{Binding CoverBrush}"
                                        BorderBrush="#55000000" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding Book.Type}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding TextBrush}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Book.Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding TextBrush}" />
                                        <TextBlock Grid.Row="2" Text="{Binding Book.Id, StringFormat='#{0}'}"
                                                   FontSize="10" HorizontalAlignment="Right"
                                                   Foreground="{Binding TextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Height="12" CornerRadius="3"
                            Background="#805A3D" BorderBrush="#A9815C" BorderThickness="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="#45505E" />

            <Border Grid.Column="2" Padding="16" CornerRadius="10" Background="#1C2129">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedBook.Book.Name}"
                                   FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Read-only preview · source files are never executed"
                                   FontSize="12" Foreground="#AAB4C3" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="monospace"
                                 FontSize="13"
                                 Padding="12"
                                 Background="#14181E"
                                 BorderThickness="0" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedBook.Book.Type}"
                               FontSize="11" Foreground="#AAB4C3" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   FontSize="12" Foreground="#AAB4C3"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
